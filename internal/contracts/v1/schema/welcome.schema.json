{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "protocol_version",
    "max_message_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "type": {
      "const": "runner.welcome"
    },
    "protocol_version": {
      "const": "1"
    },
    "max_message_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65536
    }
  }
}
