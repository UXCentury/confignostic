# Only Docker Compose reads .env. The Go API reads its process environment.
# Replace this disposable local password. Never reuse a provider or production secret.
CONFIGNOSTIC_DEV_DB_PASSWORD=replace-with-a-local-only-password
CONFIGNOSTIC_DEV_DB_PORT=5432
# Export this separately for Go commands; .env is not loaded by the Go processes.
# CONFIGNOSTIC_DATABASE_URL=postgres://confignostic:URL_ENCODED_LOCAL_PASSWORD@127.0.0.1:5432/confignostic_dev?sslmode=disable
